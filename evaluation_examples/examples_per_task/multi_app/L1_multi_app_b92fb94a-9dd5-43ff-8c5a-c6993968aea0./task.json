{
  "id": "b92fb94a-9dd5-43ff-8c5a-c6993968aea0",
  "task_slug": "workspace_policy_html_to_project_settings",
  "difficulty": "L1",
  "snapshot": "multi_apps",
  "instruction": "The local policy page at ~/Desktop/workspace_policy.html explains the required workspace editor settings for the project in ~/Desktop/ui-tooling/. Open that policy page in Chrome using the file:// URL, then create ~/Desktop/ui-tooling/.vscode/settings.json and apply the values described on the page: editor.lineNumbers should be relative, files.insertFinalNewline should be enabled, and files.exclude should hide dist and coverage. Finally, create ~/Desktop/ui-tooling/POLICY_ACK.txt containing exactly `policy applied`.",
  "source": "authors",
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "mkdir -p /home/user/Desktop/ui-tooling && printf '<html><body><h1>Workspace Policy</h1><p>editor.lineNumbers=relative</p><p>files.insertFinalNewline=true</p><p>files.exclude=dist,coverage</p></body></html>' > /home/user/Desktop/workspace_policy.html",
        "shell": true
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "google-chrome",
          "--remote-debugging-port=1337"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "socat",
          "tcp-listen:9222,fork",
          "tcp:localhost:1337"
        ]
      }
    },
    {
      "type": "chrome_open_tabs",
      "parameters": {
        "urls_to_open": [
          "file:///home/user/Desktop/workspace_policy.html"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "code",
          "/home/user/Desktop/ui-tooling"
        ]
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "chrome",
    "vscode",
    "os"
  ],
  "evaluator": {
    "func": "check_include_exclude",
    "result": {
      "type": "vm_command_line",
      "command": "python3 -c \"from pathlib import Path; p=Path('/home/user/Desktop/ui-tooling/POLICY_ACK.txt'); s=p.read_text(encoding='utf-8').strip() if p.exists() else ''; print('PASS' if s=='policy applied' else 'FAIL')\"",
      "shell": true
    },
    "expected": {
      "type": "rule",
      "rules": {
        "include": [
          "PASS"
        ],
        "exclude": [
          "FAIL"
        ]
      }
    },
    "conj": "and",
    "file": "evaluator.py"
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}
