{
  "id": "interactive_os_ambiguous_111",
  "snapshot": "os",
  "interactive": true,
  "scenario_type": "ambiguous_instruction",
  "scenario_description": "用户只笼统地说想把值班用电脑准备得更顺手，期望 Agent 先问清需要改哪些系统项，再同时调整常用收藏和电量显示并留下备忘记录。",
  "user_persona": {
    "expertise_level": "beginner",
    "communication_style": "casual_chinese"
  },
  "config": [
    {
      "type": "execute",
      "parameters": {
        "command": "export DBUS_SESSION_BUS_ADDRESS='unix:path=/run/user/1000/bus'; gsettings set org.gnome.shell favorite-apps \"['vim.desktop', 'org.gnome.Nautilus.desktop']\"; gsettings set org.gnome.desktop.interface show-battery-percentage false; rm -f/home/user/Desktop/station_prep.txt",
        "shell": true
      }
    },
    {
      "type": "execute",
      "parameters": {
        "command": [
          "python",
          "-c",
          "import pyautogui, time; pyautogui.click({SCREEN_WIDTH_HALF}, {SCREEN_HEIGHT_HALF}); time.sleep(0.5)"
        ]
      }
    }
  ],
  "phases": [
    {
      "phase_id": 1,
      "instruction": "帮我把这台值班电脑准备得顺手一点。",
      "trigger": {
        "type": "agent_asks"
      }
    },
    {
      "phase_id": 2,
      "instruction": "把收藏栏改成 thunderbird.desktop、google-chrome.desktop、org.gnome.Terminal.desktop 这三个，顺序就按我说的来。",
      "trigger": {
        "type": "agent_done"
      }
    },
    {
      "phase_id": 3,
      "instruction": "再把顶栏电量百分比打开，并在桌面新建 station_prep.txt，前 3 行按顺序写这 3 个 desktop 文件名，第 4 行写 battery-percentage=true。",
      "trigger": {
        "type": "agent_done"
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "os"
  ],
  "evaluator": {
    "func": [
      "check_favorite_apps",
      "check_battery_percentage",
      "check_station_prep_file"
    ],
    "file": "evaluator.py",
    "conj": "and",
    "postconfig": [
      {
        "type": "execute",
        "parameters": {
          "command": "export DBUS_SESSION_BUS_ADDRESS='unix:path=/run/user/1000/bus'; gsettings get org.gnome.shell favorite-apps >/tmp/fav_apps_check.txt 2>/dev/null; gsettings get org.gnome.desktop.interface show-battery-percentage >/tmp/batt_check.txt 2>/dev/null",
          "shell": true
        }
      }
    ],
    "result": [
      {
        "type": "vm_file",
        "path": "/tmp/fav_apps_check.txt",
        "dest": "fav_apps_check.txt"
      },
      {
        "type": "vm_file",
        "path": "/tmp/batt_check.txt",
        "dest": "batt_check.txt"
      },
      {
        "type": "vm_file",
        "path": "/home/user/Desktop/station_prep.txt",
        "dest": "station_prep.txt"
      }
    ],
    "expected": [
      {
        "type": "rule",
        "rules": {
          "expected": "['thunderbird.desktop','google-chrome.desktop','org.gnome.Terminal.desktop']"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected": "true"
        }
      },
      {
        "type": "rule",
        "rules": {
          "expected_content": "thunderbird.desktop\ngoogle-chrome.desktop\norg.gnome.Terminal.desktop\nbattery-percentage=true"
        }
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low"
}