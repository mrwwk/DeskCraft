{
  "id": "interactive_impress_002",
  "snapshot": "libreoffice_impress",
  "interactive": true,
  "scenario_type": "progressive_refinement",
  "scenario_description": "The user first asks to add a summary slide at the end, then asks to fill in specific content.",
  "user_persona": {
    "expertise_level": "intermediate",
    "communication_style": "casual_english"
  },
  "config": [
    {
      "type": "upload_file",
      "parameters": {
        "files": [
          {
            "local_path": "assets/pptx/libreoffice_impr_njc_pptx_shared_work_summary_template_english.pptx",
            "path": "/home/user/Desktop/work_summary_template_english.pptx"
          }
        ]
      }
    },
    {
      "type": "execute",
      "parameters": {
        "command": [
          "bash",
          "-c",
          "DISPLAY=:1 gsettings set org.gnome.desktop.screensaver idle-activation-enabled false 2>/dev/null; DISPLAY=:1 gsettings set org.gnome.desktop.session idle-delay 0 2>/dev/null; DISPLAY=:1 xset s off 2>/dev/null; DISPLAY=:1 xset -dpms 2>/dev/null; true"
        ]
      }
    },
    {
      "type": "launch",
      "parameters": {
        "command": [
          "libreoffice",
          "--norestore",
          "--nologo",
          "--impress",
          "/home/user/Desktop/work_summary_template_english.pptx"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 12
      }
    },
    {
      "type": "execute",
      "parameters": {
        "command": [
          "bash",
          "-c",
          "DISPLAY=:1 xdotool key Escape 2>/dev/null; sleep 0.3; DISPLAY=:1 xdotool search --class 'soffice' windowfocus windowraise 2>/dev/null || DISPLAY=:1 wmctrl -xa 'soffice.Soffice' 2>/dev/null || true"
        ]
      }
    },
    {
      "type": "sleep",
      "parameters": {
        "seconds": 3
      }
    }
  ],
  "phases": [
    {
      "phase_id": 1,
      "instruction": "Help me add a summary slide at the end",
      "trigger": {
        "type": "step_count",
        "value": 3
      }
    },
    {
      "phase_id": 2,
      "instruction": "On the new slide, add the title 'Q4 Summary' and the content 'Revenue target achieved.', then save",
      "trigger": {
        "type": "agent_done"
      }
    }
  ],
  "trajectory": "trajectories/",
  "related_apps": [
    "libreoffice_impress"
  ],
  "evaluator": {
    "func": "check_summary_slide",
    "file": "evaluator.py",
    "result": {
      "type": "vm_file",
      "path": "/home/user/Desktop/work_summary_template_english.pptx",
      "dest": "work_summary_template_english.pptx"
    },
    "expected": {
      "type": "rule",
      "rules": {
        "last_slide_include": [
          "Q4 Summary",
          "Revenue target achieved."
        ],
        "min_slide_count": 26
      }
    }
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low",
  "difficulty": "L2"
}
